APP_ENV=dev

# LogLevels - 0: Debug, 1: Info, 2: Warn, 3: Error, 4: Fatal, 5: Panic, 6: Nolevel, 7: disabled logger
LOG_LEVEL=0

# SERVER_MODE - debug, release. Controls logs from server
SERVER_MODE=release

APP_NAME=go-service
APP_HOST=localhost:8080
APP_SCHEME=http
APP_BASE_PATH=/api/v1

# no trailing slash
APP_URL_AUTH=http://auth-service:8080

# local
DATABASE_USER=root
DATABASE_PASSWORD=foobar
DATABASE_HOST=mysql80
DATABASE_PORT=3306
DATABASE_NAME=local

RABBIT_VIRT_HOST=/
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
